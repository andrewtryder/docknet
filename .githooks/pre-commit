#!/bin/bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
./scripts/install-quality-tools.sh
swiftlint="$PWD/build/tools/bin/swiftlint"
swiftformat="$PWD/build/tools/bin/swiftformat"
while IFS= read -r -d "" file; do
    if ! git diff --quiet -- "$file"; then
        echo "Error: stage all changes to $file before committing." >&2
        exit 1
    fi
    "$swiftformat" --lint "$file"
    "$swiftlint" lint --quiet "$file"
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- "*.swift")
